+static int emac_mii_reset_phy(struct emac_instance *dev, int addr)
+{
+	struct net_device *ndev = dev->ndev;
+	int limit = 10000;
+	int val;
+
+	val = emac_mdio_read(ndev, addr, MII_BMCR);
+	val &= ~(BMCR_ISOLATE | BMCR_ANENABLE);
+	val |= BMCR_RESET;
+	emac_mdio_write(ndev, addr, MII_BMCR, val);
+
+	udelay(300);
+
+	while (--limit) {
+		val = emac_mdio_read(ndev, addr, MII_BMCR);
+		if (val >= 0 && (val & BMCR_RESET) == 0)
+			break;
+		udelay(10);
+	}
+	if ((val & BMCR_ISOLATE) && limit > 0)
+		emac_mdio_write(ndev, addr, MII_BMCR, val & ~BMCR_ISOLATE);
+
+	return limit <= 0;
+}
+
+static void emac_mii_reset_gpcs(struct emac_instance *dev)
+{
+	struct net_device *ndev = dev->ndev;
+	int addr = dev->gpcs_address;
+
+	if (emac_mii_reset_phy(dev, addr))
+		return;
+
+	if (dev->phy_mode == PHY_INTERFACE_MODE_SGMII) {
+		/* Configure GPCS interface to recommended setting for SGMII */
+		emac_mdio_write(ndev, addr, 0x04, 0x8120); /* AsymPause, FDX */
+		emac_mdio_write(ndev, addr, 0x07, 0x2801); /* msg_pg, toggle */
+		emac_mdio_write(ndev, addr, 0x00, 0x0140); /* 1Gbps, FDX     */
+	}
+}
